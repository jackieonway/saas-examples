# Secrets are private runtime files, never Vite/browser build parameters.
RP_ORIGIN=https://rp.example.com
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=registered-user-client
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-rp-client
OIDC_SCOPES=openid profile
RP_BIND_HOST=127.0.0.1
RP_BIND_PORT=3012
RP_SESSION_SECONDS=300
RP_STATE_SECONDS=300
RP_MAX_ENTRIES=200
RP_HTTP_TIMEOUT_SECONDS=5
# With a trusted HTTPS reverse proxy, leave RP_TLS_* absent and preserve Host.
# Otherwise provide both files for direct HTTPS.
# RP_TLS_CERT_FILE=/run/tls/rp-cert.pem
# RP_TLS_KEY_FILE=/run/tls/rp-key.pem
# For a private deployment CA only (normal hostname verification remains on):
# NODE_EXTRA_CA_CERTS=/run/tls/ca.pem
# Optional machine CLI: separate confidential SERVICE/MACHINE registration.
# MACHINE_ISSUER=https://auth.example.com
# MACHINE_CLIENT_ID=registered-machine-client
# MACHINE_CLIENT_SECRET_FILE=/run/secrets/machine-client
# MACHINE_SCOPE=demo.read
# MACHINE_RESOURCE_URL=https://resource.example.com/demo
