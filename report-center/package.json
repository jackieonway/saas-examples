{
  "name": "saas-report-center",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "独立 React 报表中心，通过 HTML/UMD 与 qiankun 生命周期接入平台",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.525.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "postcss-prefix-selector": "2.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
