{
  "name": "oauth-playground",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Independent Vite OAuth rehearsal page and Rust flow API",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:api": "cargo run --locked --manifest-path backend/Cargo.toml",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test && node --test tests/delivery.mjs tests/dev.test.mjs tests/proxy.test.mjs",
    "test:nginx": "node --test tests/nginx-delivery.mjs",
    "test:api": "cargo test --locked --manifest-path backend/Cargo.toml"
  }
}
